<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.polarsys.capella.releng</groupId>
    <artifactId>capella-product-checksums</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <!-- No Capella parent: checksums must not trigger Tycho target resolution. -->
    <build>
        <plugins>
            <!-- Run explicitly after Jenkins notarization, never in the initial build. -->
            <plugin>
                <groupId>net.nicoulaj.maven.plugins</groupId>
                <artifactId>checksum-maven-plugin</artifactId>
                <version>1.11</version>
                <configuration>
                    <fileSets>
                        <fileSet>
                            <directory>${project.basedir}/target/products</directory>
                            <includes>
                                <include>capella-*-win32-win32-x86_64.zip</include>
                                <include>capella-*-linux-gtk-x86_64.tar.gz</include>
                                <include>capella-*-linux-gtk-aarch64.tar.gz</include>
                                <include>capella-*-macosx-cocoa-x86_64.dmg</include>
                                <include>capella-*-macosx-cocoa-aarch64.dmg</include>
                            </includes>
                        </fileSet>
                    </fileSets>
                    <individualFiles>true</individualFiles>
                    <shasumSummary>true</shasumSummary>
                    <csvSummary>false</csvSummary>
                    <xmlSummary>false</xmlSummary>
                    <attachChecksums>false</attachChecksums>
                    <failIfNoFiles>true</failIfNoFiles>
                    <encoding>UTF-8</encoding>
                </configuration>
                <executions>
                    <execution>
                        <id>product-sha256</id>
                        <phase>none</phase>
                        <goals>
                            <goal>files</goal>
                        </goals>
                        <configuration>
                            <algorithms>
                                <algorithm>SHA-256</algorithm>
                            </algorithms>
                            <shasumSummaryFile>products/SHA256SUMS</shasumSummaryFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>product-sha512</id>
                        <phase>none</phase>
                        <goals>
                            <goal>files</goal>
                        </goals>
                        <configuration>
                            <algorithms>
                                <algorithm>SHA-512</algorithm>
                            </algorithms>
                            <shasumSummaryFile>products/SHA512SUMS</shasumSummaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
