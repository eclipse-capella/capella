<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
	  <parent>
	    <groupId>org.polarsys</groupId>
	    <artifactId>org.polarsys.capella</artifactId>
	    <version>7.2.0-SNAPSHOT</version>
	    <relativePath>../../../</relativePath>
	  </parent>
	  <properties>
    	<sonar.skip>true</sonar.skip>
      </properties>

  <artifactId>org.polarsys.capella.rcp.product</artifactId>
  <packaging>eclipse-repository</packaging>
	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<version>${tycho-version}</version>
				<executions>
					<execution>
						<!-- install the product using the p2 director -->
						<id>materialize-products</id>
						<goals>
							<goal>materialize-products</goal>
						</goals>
					</execution>
					<execution>
						<id>archive-products</id>
						<phase>integration-test</phase>
						<goals>
							<goal>archive-products</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<formats>
						<linux>tar.gz</linux>
						<macosx>tar.gz</macosx>
						<win32>zip</win32>
					</formats>
					<products>
						<product>
							<id>org.polarsys.capella.rcp.product</id>
							<archiveFileName>${project.artifactId}-${calversion}.${buildQualifier}</archiveFileName>
							<rootFolders>
								<linux>capella</linux>
								<win32>capella</win32>
								<macosx>Capella.app</macosx>
							</rootFolders>
						</product>
					</products>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>${antrun-version}</version>
					<executions>
						<execution>
							<id>create-dropins</id>
							<phase>package</phase>
							<goals>
								<goal>run</goal>
							</goals>
							<configuration>
								<target>
									<!-- Create the dropins folder -->
									<mkdir dir="${project.build.directory}/products/org.polarsys.capella.rcp.product/linux/gtk/x86_64/capella/dropins"/>
									<mkdir dir="${project.build.directory}/products/org.polarsys.capella.rcp.product/linux/gtk/aarch64/capella/dropins"/>
									<mkdir dir="${project.build.directory}/products/org.polarsys.capella.rcp.product/macosx/cocoa/x86_64/Capella.app/Contents/Eclipse/dropins"/>
									<mkdir dir="${project.build.directory}/products/org.polarsys.capella.rcp.product/macosx/cocoa/aarch64/Capella.app/Contents/Eclipse/dropins"/>
									<mkdir dir="${project.build.directory}/products/org.polarsys.capella.rcp.product/win32/win32/x86_64/capella/dropins"/>
								</target>
							</configuration>
						</execution>
						<execution>
							<id>package-product</id>
							<phase>package</phase>
							<goals>
								<goal>run</goal>
							</goals>
							<configuration>
								<!-- Complete the installations before Tycho archives them. -->
								<target>								
									
									
									<!-- Copy logback.xml into configuration folder -->
									<copy file="logback.xml" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/linux/gtk/x86_64/capella/configuration/logback.xml" ></copy>
									<copy file="logback.xml" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/linux/gtk/aarch64/capella/configuration/logback.xml" ></copy>
									<copy file="logback.xml" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/macosx/cocoa/x86_64/Capella.app/Contents/Eclipse/configuration/logback.xml" ></copy>
									<copy file="logback.xml" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/macosx/cocoa/aarch64/Capella.app/Contents/Eclipse/configuration/logback.xml" ></copy>
									<copy file="logback.xml" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/win32/win32/x86_64/capella/configuration/logback.xml" ></copy>
									
									<!--  Copy the Linux JRE into the product -->
									<copy todir="${project.build.directory}/products/org.polarsys.capella.rcp.product/linux/gtk/x86_64/capella/jre" includeEmptyDirs="yes">
										<fileset dir="../../../linuxJRE/jre">
											<include name="**/*" />
										</fileset>
									</copy>
									
									<!--  Copy the Linux aarch64 JRE into the product -->
									<copy todir="${project.build.directory}/products/org.polarsys.capella.rcp.product/linux/gtk/aarch64/capella/jre" includeEmptyDirs="yes">
										<fileset dir="../../../linux-aarch64JRE/jre">
											<include name="**/*" />
										</fileset>
									</copy>
									
									<!--  Copy the Mac x86_64 JRE into the product -->
									<copy todir="${project.build.directory}/products/org.polarsys.capella.rcp.product/macosx/cocoa/x86_64/Capella.app/Contents/jre" includeEmptyDirs="yes">
										<fileset dir="../../../macJRE/jre">
											<include name="**/*" />
										</fileset>
									</copy>
									
									<!--  Copy the Mac arch64 JRE into the product -->
									<copy todir="${project.build.directory}/products/org.polarsys.capella.rcp.product/macosx/cocoa/aarch64/Capella.app/Contents/jre" includeEmptyDirs="yes">
										<fileset dir="../../../mac-aarch64JRE/jre">
											<include name="**/*" />
										</fileset>
									</copy>
									
									<!--  Copy the Windows JRE into the product -->
									<copy todir="${project.build.directory}/products/org.polarsys.capella.rcp.product/win32/win32/x86_64/capella/jre" includeEmptyDirs="yes">
										<fileset dir="../../../winJRE/jre">
											<include name="**/*" />
										</fileset>
									</copy>

									<!-- Samples are part of the final distribution before archiving/signing. -->
									<copy file="../../../samples/target/IFE_samplemodel.zip" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/linux/gtk/x86_64/samples/IFE_samplemodel.zip"/>
									<copy file="../../../samples/target/IFE_samplemodel.zip" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/linux/gtk/aarch64/samples/IFE_samplemodel.zip"/>
									<copy file="../../../samples/target/IFE_samplemodel.zip" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/win32/win32/x86_64/samples/IFE_samplemodel.zip"/>
									<copy file="../../../samples/target/IFE_samplemodel.zip" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/macosx/cocoa/x86_64/Capella.app/Contents/samples/IFE_samplemodel.zip"/>
									<copy file="../../../samples/target/IFE_samplemodel.zip" tofile="${project.build.directory}/products/org.polarsys.capella.rcp.product/macosx/cocoa/aarch64/Capella.app/Contents/samples/IFE_samplemodel.zip"/>

									<!-- Tycho preserves permissions; restore execute bits lost by Ant copy first. -->
									<chmod dir="${project.build.directory}/products/org.polarsys.capella.rcp.product" perm="755" osfamily="unix"
										includes="linux/gtk/*/capella/capella,linux/gtk/*/capella/jre/bin/*,linux/gtk/*/capella/jre/lib/jspawnhelper,macosx/cocoa/*/Capella.app/Contents/MacOS/capella,macosx/cocoa/*/Capella.app/Contents/jre/Contents/Home/bin/*,macosx/cocoa/*/Capella.app/Contents/jre/Contents/Home/lib/jspawnhelper"/>
								</target>
							</configuration>
						</execution>
					<execution>
						<id>publish-product-archives</id>
						<phase>integration-test</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<!-- Keep Tycho's attached artifacts and Capella's public download names. -->
								<copy file="${project.build.directory}/products/${project.artifactId}-${calversion}.${buildQualifier}-linux.gtk.x86_64.tar.gz" tofile="${project.build.directory}/products/capella-${calversion}.${buildQualifier}-linux-gtk-x86_64.tar.gz"/>
								<copy file="${project.build.directory}/products/${project.artifactId}-${calversion}.${buildQualifier}-linux.gtk.aarch64.tar.gz" tofile="${project.build.directory}/products/capella-${calversion}.${buildQualifier}-linux-gtk-aarch64.tar.gz"/>
								<copy file="${project.build.directory}/products/${project.artifactId}-${calversion}.${buildQualifier}-macosx.cocoa.x86_64.tar.gz" tofile="${project.build.directory}/products/capella-${calversion}.${buildQualifier}-macosx-cocoa-x86_64.tar.gz"/>
								<copy file="${project.build.directory}/products/${project.artifactId}-${calversion}.${buildQualifier}-macosx.cocoa.aarch64.tar.gz" tofile="${project.build.directory}/products/capella-${calversion}.${buildQualifier}-macosx-cocoa-aarch64.tar.gz"/>
								<copy file="${project.build.directory}/products/${project.artifactId}-${calversion}.${buildQualifier}-win32.win32.x86_64.zip" tofile="${project.build.directory}/products/capella-${calversion}.${buildQualifier}-win32-win32-x86_64.zip"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>create-bom</id>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
